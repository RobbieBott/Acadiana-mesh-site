diff --git a/cmd/ingestor/device_archive.go b/cmd/ingestor/device_archive.go
new file mode 100644
index 0000000000000000000000000000000000000000..84db90c54199432f26ac446438eeea8ac9c1705b
--- /dev/null
+++ b/cmd/ingestor/device_archive.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"fmt"
+
+	"github.com/meshcore-analyzer/prunequeue"
+)
+
+func (s *Store) RunPendingDeviceArchiveRequests() {
+	runPendingPruneRequests(prunequeue.DeviceArchiveQueuePath(s.path), s.archiveDevice)
+}
+
+func (s *Store) archiveDevice(req *prunequeue.Request) (int64, error) {
+	if len(req.Pubkeys) != 1 || req.Pubkeys[0] == "" || req.LastSeen == nil {
+		return 0, fmt.Errorf("invalid device archive request")
+	}
+	id, lastSeen := req.Pubkeys[0], *req.LastSeen
+	switch req.Reason {
+	case "observer":
+		// Live status or packet input reactivates the existing observer row.
+		result, err := s.instrumentedExec("archive_observer", `
+			UPDATE observers SET inactive = 1
+			WHERE id = ? AND COALESCE(last_seen, '') = ? AND COALESCE(inactive, 0) = 0`, id, lastSeen)
+		if err != nil {
+			return 0, err
+		}
+		return result.RowsAffected()
+	case "repeater":
+		return s.archiveRepeater(id, lastSeen)
+	default:
+		return 0, fmt.Errorf("unknown device kind")
+	}
+}
+
+func (s *Store) archiveRepeater(id, lastSeen string) (int64, error) {
+	// Same move as automatic node retention, limited to the exact reviewed row.
+	// A report arriving after the operator loaded the list changes last_seen
+	// and makes the entire operation a no-op.
+	const match = " WHERE public_key = ? AND role = 'repeater' AND COALESCE(last_seen, '') = ?"
+	tx, err := s.db.Begin()
+	if err != nil {
+		return 0, err
+	}
+	defer tx.Rollback()
+	if _, err := tx.Exec("INSERT OR REPLACE INTO inactive_nodes SELECT * FROM nodes"+match, id, lastSeen); err != nil {
+		return 0, err
+	}
+	result, err := tx.Exec("DELETE FROM nodes"+match, id, lastSeen)
+	if err != nil {
+		return 0, err
+	}
+	changed, err := result.RowsAffected()
+	if err != nil {
+		return 0, err
+	}
+	return changed, tx.Commit()
+}
diff --git a/cmd/ingestor/device_archive_test.go b/cmd/ingestor/device_archive_test.go
new file mode 100644
