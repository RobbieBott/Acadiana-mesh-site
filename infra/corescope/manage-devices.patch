@@ -0,0 +1,101 @@
+package main
+
+import (
+	"testing"
+	"time"
+
+	"github.com/meshcore-analyzer/prunequeue"
+)
+
+func TestDeviceArchiveQueueAndReactivation(t *testing.T) {
+	store := newTestStore(t)
+	seen := "2026-01-01T00:00:00Z"
+	fresh := "2026-01-01T01:00:00Z"
+	const sqlSeed = `
+		INSERT INTO nodes (public_key, name, role, last_seen, advert_count) VALUES
+			('target', 'Same radio', 'repeater', '2026-01-01T00:00:00Z', 17),
+			('other', 'Same radio', 'repeater', '2026-01-01T01:00:00Z', 8),
+			('companion', 'Companion', 'companion', '2026-01-01T00:00:00Z', 2);
+		INSERT INTO observers (id, name, last_seen) VALUES
+			('target', 'Same radio', '2026-01-01T00:00:00Z');
+		INSERT INTO observer_metrics (observer_id, timestamp) VALUES
+			('target', '2026-01-01T00:00:00Z');`
+	if _, err := store.db.Exec(sqlSeed); err != nil {
+		t.Fatal(err)
+	}
+	count := func(stmt string) int {
+		t.Helper()
+		var result int
+		if err := store.db.QueryRow(stmt).Scan(&result); err != nil {
+			t.Fatal(err)
+		}
+		return result
+	}
+	queue := prunequeue.DeviceArchiveQueuePath(store.path)
+
+	repeaterRequest := prunequeue.Request{
+		ID: prunequeue.NewID(), Reason: "repeater", RequestedAt: time.Now(),
+		Pubkeys: []string{"target"}, LastSeen: &seen,
+	}
+	if err := prunequeue.WriteRequest(queue, repeaterRequest); err != nil {
+		t.Fatal(err)
+	}
+	store.RunPendingPruneRequests()
+	if n := count("SELECT COUNT(*) FROM nodes WHERE public_key = 'target'"); n != 1 {
+		t.Fatal("geo-prune worker must not process device archive requests")
+	}
+	store.RunPendingDeviceArchiveRequests()
+	result, err := prunequeue.ReadResult(queue, repeaterRequest.ID)
+	if err != nil || result == nil || result.Deleted != 1 || result.Error != "" {
+		t.Fatalf("archive result = %+v, err = %v", result, err)
+	}
+	if n := count("SELECT COUNT(*) FROM nodes WHERE public_key = 'target'"); n != 0 {
+		t.Fatal("archived repeater must leave the active nodes table")
+	}
+	if n := count("SELECT advert_count FROM inactive_nodes WHERE public_key = 'target'"); n != 17 {
+		t.Fatal("repeater metadata must be preserved in inactive_nodes")
+	}
+	if n := count("SELECT inactive FROM observers WHERE id = 'target'"); n != 0 {
+		t.Fatal("archiving a repeater must not affect the same radio's observer entry")
+	}
+
+	for _, id := range []string{"other", "companion"} {
+		req := prunequeue.Request{Reason: "repeater", Pubkeys: []string{id}, LastSeen: &seen}
+		if changed, err := store.archiveDevice(&req); err != nil || changed != 0 {
+			t.Fatalf("wrong snapshot or role should not archive %s: changed=%d err=%v", id, changed, err)
+		}
+	}
+
+	if err := store.UpsertNode("target", "Same radio", "repeater", nil, nil, fresh); err != nil {
+		t.Fatal(err)
+	}
+	if changed, err := store.archiveDevice(&repeaterRequest); err != nil || changed != 0 {
+		t.Fatalf("retry must not archive a refreshed repeater: changed=%d err=%v", changed, err)
+	}
+	if n := count("SELECT COUNT(*) FROM nodes WHERE public_key = 'target'"); n != 1 {
+		t.Fatal("a fresh advert must recreate the active repeater entry")
+	}
+
+	observerRequest := prunequeue.Request{Reason: "observer", Pubkeys: []string{"target"}, LastSeen: &seen}
+	if changed, err := store.archiveDevice(&observerRequest); err != nil || changed != 1 {
+		t.Fatalf("archive observer: changed=%d err=%v", changed, err)
+	}
+	if n := count("SELECT COUNT(*) FROM observer_metrics WHERE observer_id = 'target'"); n != 1 {
+		t.Fatal("observer metrics must survive archiving")
+	}
+	if err := store.UpsertObserverRetained("target", "Same radio", "LFT", nil); err != nil {
+		t.Fatal(err)
+	}
+	if n := count("SELECT inactive FROM observers WHERE id = 'target'"); n != 1 {
+		t.Fatal("retained MQTT status must not reactivate an archived observer")
+	}
+	if err := store.UpsertObserverAt("target", "Same radio", "LFT", nil, fresh); err != nil {
+		t.Fatal(err)
+	}
+	if changed, err := store.archiveDevice(&observerRequest); err != nil || changed != 0 {
+		t.Fatalf("retry must not archive a refreshed observer: changed=%d err=%v", changed, err)
+	}
+	if n := count("SELECT inactive FROM observers WHERE id = 'target'"); n != 0 {
+		t.Fatal("live observer status must reactivate the observer")
+	}
+}
