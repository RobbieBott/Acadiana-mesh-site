diff --git a/public/admin-devices.js b/public/admin-devices.js
new file mode 100644
index 0000000000000000000000000000000000000000..a87d08b423136fe70bf69ace915f5ab11da5b6b7
--- /dev/null
+++ b/public/admin-devices.js
@@ -0,0 +1,258 @@
+/* Device cleanup in the CoreScope admin area. */
+(function () {
+  'use strict';
+
+  var API = '/api/admin/devices';
+  var PAGE_SIZE = 40;
+  var STALE_MS = 24 * 60 * 60 * 1000;
+  var POLL_MS = 2000;
+  var MAX_POLLS = 30;
+  var view = null;
+
+  function readFilters(hash) {
+    var params = new URLSearchParams(String(hash || '').split('?')[1] || '');
+    var kind = params.get('kind');
+    return {
+      search: params.get('q') || '',
+      kind: kind === 'repeater' || kind === 'observer' ? kind : '',
+      stale: params.get('stale') === '1'
+    };
+  }
+
+  function filterHash(filters) {
+    var params = new URLSearchParams({ tab: 'devices' });
+    if (filters.search) params.set('q', filters.search);
+    if (filters.kind) params.set('kind', filters.kind);
+    if (filters.stale) params.set('stale', '1');
+    return '#/admin?' + params.toString();
+  }
+
+  function isStale(device, now) {
+    var seen = Date.parse(device.lastHeard || device.lastSeen);
+    return Number.isFinite(seen) && now - seen >= STALE_MS;
+  }
+
+  function filterDevices(devices, filters, now) {
+    var search = filters.search.trim().toLowerCase();
+    return devices.filter(function (device) {
+      return (!filters.kind || device.kind === filters.kind) &&
+        (!filters.stale || isStale(device, now)) &&
+        (!search || (device.name || '').toLowerCase().includes(search) || device.id.toLowerCase().includes(search));
+    });
+  }
+
+  function request(method, path, body) {
+    return CSAuth.request(method, path, body).then(function (response) {
+      if (!response.ok) throw new Error(CSAuth.errText(response));
+      return response.data;
+    });
+  }
+
+  function render(state) {
+    var now = Date.now();
+    var matching = filterDevices(state.devices, state.filters, now);
+    var lastPage = Math.max(0, Math.ceil(matching.length / PAGE_SIZE) - 1);
+    state.page = Math.min(state.page, lastPage);
+    var start = state.page * PAGE_SIZE;
+    var end = Math.min(start + PAGE_SIZE, matching.length);
+    var rows = document.createDocumentFragment();
+
+    matching.slice(start, end).forEach(function (device) {
+      var row = document.createElement('tr');
+      var name = row.insertCell();
+      var identity = document.createElement('code');
+      name.textContent = device.name || 'Unnamed device';
+      identity.textContent = device.id;
+      name.appendChild(identity);
+
+      var kindLabel = device.kind === 'repeater' ? 'Repeater' : 'Observer';
+      var kind = document.createElement('span');
+      kind.className = 'um-status admin-device-kind admin-device-' + device.kind;
+      kind.textContent = kindLabel;
+      row.insertCell().appendChild(kind);
+
+      var seen = row.insertCell();
+      var date = new Date(device.lastHeard || device.lastSeen || NaN);
+      seen.textContent = Number.isNaN(date.getTime()) ? 'Unknown' : date.toLocaleString();
+      if (isStale(device, now)) seen.className = 'admin-device-stale';
+
+      var button = document.createElement('button');
+      button.type = 'button';
+      button.className = 'account-btn account-btn-secondary';
+      button.textContent = 'Archive';
+      button.disabled = state.busy;
+      button.setAttribute('aria-label', 'Archive ' + kindLabel.toLowerCase() + ' ' + (device.name || device.id));
+      button.addEventListener('click', function () { openConfirm(state, device, button); });
+      row.insertCell().appendChild(button);
+      rows.appendChild(row);
+    });
+
+    state.body.replaceChildren(rows);
+    var empty = (state.filters.search || state.filters.kind || state.filters.stale)
+      ? 'No devices match these filters.'
+      : 'No active repeaters or observers.';
+    state.count.textContent = matching.length
+      ? (start + 1) + '–' + end + ' of ' + matching.length + ' devices'
+      : empty;
+    if (state.hasMore) state.count.textContent += ' The list is limited to 5,000 devices.';
+    state.pagination.hidden = lastPage === 0;
+    state.previous.disabled = state.page === 0;
+    state.next.disabled = state.page === lastPage;
+  }
+
+  function say(state, message, ok) {
+    if (view === state) CSAuth.say('adminDeviceMessage', message, ok);
+  }
+
+  async function load(state) {
+    var devices = await request('GET', API);
+    if (view !== state) return;
+    state.devices = devices.devices;
+    state.hasMore = devices.hasMore;
+  }
+
+  async function pollArchive(state, id) {
+    for (var attempt = 0; view === state && attempt < MAX_POLLS; attempt++) {
+      await new Promise(function (resolve) { setTimeout(resolve, POLL_MS); });
+      if (view !== state) return null;
+      var result = await request('GET', API + '/status?id=' + encodeURIComponent(id));
+      if (result.status === 'error') throw new Error('CoreScope could not archive this device.');
+      if (result.status === 'done') return result;
+    }
+    return null;
+  }
+
+  function openConfirm(state, device, button) {
+    if (state.busy || state.dialog.open) return;
+    state.selected = device;
+    state.trigger = button;
+    state.dialog.returnValue = '';
+    state.confirmDescription.textContent = 'Archive ' + (device.name || device.id) +
+      '? It will leave the active CoreScope list. A new report can bring it back.';
+    state.confirmIdentity.textContent = device.id;
+    state.dialog.showModal();
+  }
+
+  async function archiveSelected(state) {
+    if (!state.selected || state.busy) return;
+    var device = state.selected;
+    state.busy = true;
+    render(state);
+    say(state, 'Archiving device…', true);
+    var accepted = false;
+    try {
+      var queued = await request('POST', API, { id: device.id, kind: device.kind, lastSeen: device.lastSeen });
+      if (view !== state) return;
+      accepted = true;
+      var result = await pollArchive(state, queued.requestId);
+      if (view !== state) return;
+      if (!result) {
+        say(state, 'The request is still queued. Refresh this page to check the active list.', false);
+      } else if (result.changed > 0) {
+        say(state, 'Device archived.', true);
+      } else {
+        say(state, 'The device changed after the list was loaded. Review its latest activity before trying again.', false);
+      }
+    } catch (err) {
+      say(state, err.message || 'The archive could not be confirmed.', false);
+    } finally {
+      if (view === state) {
+        try {
+          await load(state);
+        } catch (_) {
+          if (accepted) say(state, 'Refresh this page to check the active list.', false);
+        }
+        state.busy = false;
+        if (view === state) {
+          render(state);
+          state.message.focus();
+        }
+      }
+    }
+  }
+
+  function updateFilters(state) {
+    clearTimeout(state.filterTimer);
+    if (view !== state) return;
+    state.filters = { search: state.search.value, kind: state.kind.value, stale: state.stale.checked };
+    state.page = 0;
+    history.replaceState(null, '', filterHash(state.filters));
+    render(state);
+  }
+
+  function mount(container) {
+    container.innerHTML = '<section class="admin-devices" aria-labelledby="adminDevicesTitle">' +
+      '<h3 id="adminDevicesTitle">Manage CoreScope</h3>' +
+      '<p class="account-hint">Archive devices you no longer expect to report. A new report can bring them back.</p>' +
+      '<div class="um-filters admin-device-filters">' +
+      '<label class="account-field">Find a device<input id="adminDeviceSearch" type="search" placeholder="Name or device ID"></label>' +
+      '<label class="account-field">Device type<select id="adminDeviceKind">' +
+      '<option value="">All types</option><option value="repeater">Repeaters</option><option value="observer">Observers</option></select></label>' +
+      '<label class="admin-device-stale-filter"><input id="adminDeviceStale" type="checkbox"> Stale only (24+ hours)</label></div>' +
+      '<p class="account-msg" id="adminDeviceMessage" role="status" tabindex="-1"></p>' +
+      '<div class="um-table-wrap"><table class="um-table"><thead><tr>' +
+      '<th scope="col">Device</th><th scope="col">Type</th><th scope="col">Last seen</th><th scope="col">Action</th>' +
+      '</tr></thead><tbody id="adminDeviceRows"></tbody></table></div>' +
+      '<div class="admin-device-footer"><p class="account-hint" id="adminDeviceCount" role="status">Loading devices…</p>' +
+      '<div id="adminDevicePagination" hidden><button type="button" class="account-btn account-btn-secondary" id="adminDevicesPrevious">Previous</button> ' +
+      '<button type="button" class="account-btn account-btn-secondary" id="adminDevicesNext">Next</button></div></div>' +
+      '<dialog id="adminDeviceConfirm" aria-labelledby="adminDeviceConfirmTitle" aria-describedby="adminDeviceConfirmDescription">' +
+      '<h4 id="adminDeviceConfirmTitle">Archive this device?</h4><p id="adminDeviceConfirmDescription"></p>' +
+      '<code id="adminDeviceConfirmIdentity"></code><form method="dialog" class="um-actions">' +
+      '<button value="cancel" class="account-btn account-btn-secondary" autofocus>Cancel</button>' +
+      '<button value="archive" class="account-btn account-btn-primary">Archive device</button></form></dialog></section>';
+
+    var state = view = {
+      devices: [], filters: readFilters(location.hash), page: 0, busy: false,
+      body: container.querySelector('#adminDeviceRows'),
+      count: container.querySelector('#adminDeviceCount'),
+      message: container.querySelector('#adminDeviceMessage'),
+      pagination: container.querySelector('#adminDevicePagination'),
+      previous: container.querySelector('#adminDevicesPrevious'),
+      next: container.querySelector('#adminDevicesNext'),
+      search: container.querySelector('#adminDeviceSearch'),
+      kind: container.querySelector('#adminDeviceKind'),
+      stale: container.querySelector('#adminDeviceStale'),
+      dialog: container.querySelector('#adminDeviceConfirm'),
+      confirmDescription: container.querySelector('#adminDeviceConfirmDescription'),
+      confirmIdentity: container.querySelector('#adminDeviceConfirmIdentity')
+    };
+    state.search.value = state.filters.search;
+    state.kind.value = state.filters.kind;
+    state.stale.checked = state.filters.stale;
+    state.search.addEventListener('input', function () {
+      clearTimeout(state.filterTimer);
+      state.filterTimer = setTimeout(function () { updateFilters(state); }, 120);
+    });
+    state.kind.addEventListener('change', function () { updateFilters(state); });
+    state.stale.addEventListener('change', function () { updateFilters(state); });
+    state.previous.addEventListener('click', function () { state.page--; render(state); });
+    state.next.addEventListener('click', function () { state.page++; render(state); });
+    state.dialog.addEventListener('close', function () {
+      if (view !== state) return;
+      if (state.dialog.returnValue === 'archive') {
+        archiveSelected(state);
+      } else if (state.trigger) {
+        state.trigger.focus();
+      }
+      state.selected = null;
+      state.trigger = null;
+    });
+    return load(state).then(function () {
+      if (view === state) render(state);
+    }).catch(function (err) {
+      if (view !== state) return;
+      state.count.textContent = '';
+      say(state, err.message || 'Could not load CoreScope devices.', false);
+    });
+  }
+
+  function unmount() {
+    var state = view;
+    view = null;
+    if (state) clearTimeout(state.filterTimer);
+  }
+
+  window.CSAdminDevices = { mount: mount, unmount: unmount,
+    _test: { readFilters: readFilters, filterHash: filterHash, filterDevices: filterDevices, isStale: isStale } };
+})();
