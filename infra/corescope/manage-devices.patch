diff --git a/cmd/server/admin_devices.go b/cmd/server/admin_devices.go
new file mode 100644
index 0000000000000000000000000000000000000000..3d17ac9a33809d841739bc0cc8d3b98295bc7e5b
--- /dev/null
+++ b/cmd/server/admin_devices.go
@@ -0,0 +1,164 @@
+package main
+
+import (
+	"encoding/json"
+	"log"
+	"net/http"
+	"time"
+
+	"github.com/meshcore-analyzer/prunequeue"
+	"github.com/meshcore-analyzer/users"
+)
+
+type adminDevice struct {
+	ID        string `json:"id"`
+	Name      string `json:"name"`
+	Kind      string `json:"kind"`
+	LastSeen  string `json:"lastSeen"`
+	LastHeard string `json:"lastHeard,omitempty"`
+}
+
+type adminDevicesResponse struct {
+	Devices []adminDevice `json:"devices"`
+	HasMore bool          `json:"hasMore"`
+}
+
+func (s *Server) handleAdminDevices(w http.ResponseWriter, r *http.Request, _ *users.User, _ *users.Session) {
+	w.Header().Set("Cache-Control", "no-store")
+	limit := queryLimit(r, 5000, 5000)
+	offset := max(queryInt(r, "offset", 0), 0)
+	rows, err := s.db.conn.QueryContext(r.Context(), `
+		SELECT public_key AS id, COALESCE(name, '') AS name, 'repeater' AS kind, COALESCE(last_seen, '') AS seen
+		FROM nodes WHERE role = 'repeater' AND public_key <> ''
+		UNION ALL
+		SELECT id, COALESCE(name, ''), 'observer', COALESCE(last_seen, '')
+		FROM observers WHERE COALESCE(inactive, 0) = 0 AND id <> ''
+		ORDER BY kind, id LIMIT ? OFFSET ?`, limit+1, offset)
+	if err != nil {
+		log.Printf("[device-archive] list devices: %v", err)
+		writeError(w, http.StatusInternalServerError, "could not load devices")
+		return
+	}
+	defer rows.Close()
+
+	resp := adminDevicesResponse{Devices: []adminDevice{}}
+	var repeaterIDs []string
+	for rows.Next() {
+		if len(resp.Devices) == limit {
+			resp.HasMore = true
+			break
+		}
+		var device adminDevice
+		if err := rows.Scan(&device.ID, &device.Name, &device.Kind, &device.LastSeen); err != nil {
+			log.Printf("[device-archive] read device: %v", err)
+			writeError(w, http.StatusInternalServerError, "could not load devices")
+			return
+		}
+		if device.Kind == "repeater" {
+			repeaterIDs = append(repeaterIDs, device.ID)
+		}
+		resp.Devices = append(resp.Devices, device)
+	}
+	if err := rows.Err(); err != nil {
+		log.Printf("[device-archive] read devices: %v", err)
+		writeError(w, http.StatusInternalServerError, "could not load devices")
+		return
+	}
+	rows.Close()
+	if s.store != nil && len(repeaterIDs) > 0 {
+		heard, _ := s.store.LastHeardMap(repeaterIDs)
+		for i := range resp.Devices {
+			device := &resp.Devices[i]
+			if device.Kind == "repeater" {
+				device.LastHeard, _ = lastHeardValue(device.LastSeen, heard[device.ID]).(string)
+			}
+		}
+	}
+	writeJSON(w, resp)
+}
+
+type deviceArchiveRequest struct {
+	ID       string  `json:"id"`
+	Kind     string  `json:"kind"`
+	LastSeen *string `json:"lastSeen"`
+}
+
+type deviceArchiveAccepted struct {
+	RequestID string `json:"requestId"`
+}
+
+func (s *Server) handleAdminDeviceArchive(w http.ResponseWriter, r *http.Request, u *users.User, _ *users.Session) {
+	w.Header().Set("Cache-Control", "no-store")
+	r.Body = http.MaxBytesReader(w, r.Body, 2048)
+	var body deviceArchiveRequest
+	if err := json.NewDecoder(r.Body).Decode(&body); err != nil ||
+		body.ID == "" || len(body.ID) > 128 ||
+		(body.Kind != "repeater" && body.Kind != "observer") ||
+		body.LastSeen == nil || len(*body.LastSeen) > 64 {
+		writeError(w, http.StatusBadRequest, "invalid device selection")
+		return
+	}
+
+	req := prunequeue.Request{
+		ID:          prunequeue.NewID(),
+		RequestedAt: time.Now().UTC(),
+		Reason:      body.Kind,
+		Pubkeys:     []string{body.ID},
+		LastSeen:    body.LastSeen,
+	}
+	if err := prunequeue.WriteRequest(prunequeue.DeviceArchiveQueuePath(s.db.path), req); err != nil {
+		log.Printf("[device-archive] enqueue request %s: %v", req.ID, err)
+		writeError(w, http.StatusInternalServerError, "could not queue device archive")
+		return
+	}
+	s.auth.audit(&u.ID, "device.archive.requested", nil, map[string]string{
+		"deviceId":  body.ID,
+		"kind":      body.Kind,
+		"requestId": req.ID,
+	})
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusAccepted)
+	_ = json.NewEncoder(w).Encode(deviceArchiveAccepted{RequestID: req.ID})
+}
+
+type deviceArchiveStatus struct {
+	RequestID string `json:"requestId"`
+	Status    string `json:"status"`
+	Changed   int64  `json:"changed"`
+}
+
+func (s *Server) handleAdminDeviceArchiveStatus(w http.ResponseWriter, r *http.Request, _ *users.User, _ *users.Session) {
+	w.Header().Set("Cache-Control", "no-store")
+	queuePath := prunequeue.DeviceArchiveQueuePath(s.db.path)
+	id := r.URL.Query().Get("id")
+	if _, err := prunequeue.ResultPath(queuePath, id); err != nil {
+		writeError(w, http.StatusBadRequest, "invalid request id")
+		return
+	}
+	// The worker publishes the result before removing the request marker.
+	pending, err := prunequeue.RequestExists(queuePath, id)
+	if err != nil {
+		log.Printf("[device-archive] check request %s: %v", id, err)
+		writeError(w, http.StatusInternalServerError, "could not check device archive")
+		return
+	}
+	if pending {
+		writeJSON(w, deviceArchiveStatus{RequestID: id, Status: "pending"})
+		return
+	}
+	result, err := prunequeue.ReadResult(queuePath, id)
+	if err != nil {
+		log.Printf("[device-archive] read result %s: %v", id, err)
+		writeError(w, http.StatusInternalServerError, "could not check device archive")
+		return
+	}
+	if result == nil {
+		writeError(w, http.StatusNotFound, "device archive request not found")
+		return
+	}
+	status := "done"
+	if result.Error != "" {
+		status = "error"
+	}
+	writeJSON(w, deviceArchiveStatus{RequestID: id, Status: status, Changed: result.Deleted})
+}
diff --git a/cmd/server/admin_devices_test.go b/cmd/server/admin_devices_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c4feda4ed246c8e1fbfa856b41450cb48af1afb6
--- /dev/null
+++ b/cmd/server/admin_devices_test.go
@@ -0,0 +1,82 @@
+package main
+
+import (
+	"net/http"
+	"path/filepath"
+	"testing"
+
+	"github.com/meshcore-analyzer/prunequeue"
+	"github.com/meshcore-analyzer/users"
+)
+
+func TestAdminDeviceListAndArchive(t *testing.T) {
+	const endpoint = "/api/admin/devices"
+	fixture := newAuthFixture(t, "admin@example.org")
+	fixture.srv.db = setupTestDB(t)
+	t.Cleanup(func() { fixture.srv.db.conn.Close() })
+	fixture.srv.db.path = filepath.Join(t.TempDir(), "meshcore.db")
+	if _, err := fixture.srv.db.conn.Exec(`
+		INSERT INTO nodes (public_key, name, role, last_seen) VALUES
+			('key', 'Shared radio', 'repeater', '2026-01-01T00:00:00Z'),
+			('room', 'Room', 'room', NULL);
+		INSERT INTO observers (id, name, inactive) VALUES
+			('key', 'Shared radio', 0), ('inactive', 'Archived', 1);`); err != nil {
+		t.Fatal(err)
+	}
+	admin := fixture.registerAndActivate(t, "admin@example.org", "Admin", "strong password a")
+	member := fixture.registerAndActivate(t, "member@example.org", "Member", "strong password b")
+	expectStatus(t, fixture.do("GET", endpoint, nil), http.StatusUnauthorized)
+	expectStatus(t, fixture.do("GET", endpoint, nil, as(member)), http.StatusForbidden)
+	w := fixture.do("GET", endpoint, nil, as(admin))
+	expectStatus(t, w, http.StatusOK)
+	if w.Header().Get("Cache-Control") != "no-store" {
+		t.Fatal("admin device list must not be cached")
+	}
+	devices := decode[adminDevicesResponse](t, w).Devices
+	if len(devices) != 2 || devices[0].Kind != "observer" || devices[1].Kind != "repeater" {
+		t.Fatalf("expected active observer and repeater, got %+v", devices)
+	}
+	if devices[0].ID != devices[1].ID || devices[0].LastSeen != "" || devices[1].LastSeen == "" {
+		t.Fatalf("device kind or raw last-seen value lost: %+v", devices)
+	}
+
+	body := deviceArchiveRequest{ID: devices[1].ID, Kind: devices[1].Kind, LastSeen: &devices[1].LastSeen}
+	expectStatus(t, fixture.do("POST", endpoint, body, as(member)), http.StatusForbidden)
+	expectStatus(t, fixture.do("POST", endpoint, body, as(&client{cookie: admin.cookie})), http.StatusForbidden)
+	expectStatus(t, fixture.do("POST", endpoint, deviceArchiveRequest{ID: body.ID, Kind: body.Kind}, as(admin)), http.StatusBadRequest)
+	w = fixture.do("POST", endpoint, body, as(admin))
+	expectStatus(t, w, http.StatusAccepted)
+	id := decode[deviceArchiveAccepted](t, w).RequestID
+	queue := prunequeue.DeviceArchiveQueuePath(fixture.srv.db.path)
+	path, err := prunequeue.RequestPath(queue, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req, err := prunequeue.ReadRequest(path)
+	if err != nil || len(req.Pubkeys) != 1 || req.Pubkeys[0] != body.ID || req.Reason != body.Kind || req.LastSeen == nil || *req.LastSeen != *body.LastSeen {
+		t.Fatalf("unexpected queue marker %+v: %v", req, err)
+	}
+	if exists, err := prunequeue.RequestExists(fixture.srv.db.path, id); err != nil || exists {
+		t.Fatalf("archive must not enter geo-prune queue: exists=%t err=%v", exists, err)
+	}
+	audit, err := fixture.st.AuditList(users.AuditFilter{Actions: []string{"device.archive.requested"}, Limit: 5})
+	if err != nil || len(audit) != 1 || audit[0].ActorUserID == nil || audit[0].Detail["requestId"] != id {
+		t.Fatalf("archive request missing from audit: %+v, %v", audit, err)
+	}
+
+	statusPath := endpoint + "/status?id=" + id
+	expectStatus(t, fixture.do("GET", statusPath, nil, as(member)), http.StatusForbidden)
+	w = fixture.do("GET", statusPath, nil, as(admin))
+	expectStatus(t, w, http.StatusOK)
+	if status := decode[deviceArchiveStatus](t, w); status.Status != "pending" {
+		t.Fatalf("unexpected queue state %+v", status)
+	}
+	if err := prunequeue.WriteResult(queue, prunequeue.Result{ID: id, Deleted: 1}); err != nil {
+		t.Fatal(err)
+	}
+	w = fixture.do("GET", statusPath, nil, as(admin))
+	expectStatus(t, w, http.StatusOK)
+	if status := decode[deviceArchiveStatus](t, w); status.Status != "done" || status.Changed != 1 {
+		t.Fatalf("unexpected finished state %+v", status)
+	}
+}
